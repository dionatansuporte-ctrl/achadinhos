DATABASE_URL=postgresql://postgres:postgres@localhost:5432/achadinhopro
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:5173
API_URL=http://localhost:3333
JWT_SECRET=change-this-to-a-long-random-secret
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# URL de retorno do OAuth do ML. Em branco usa a página pública do GitHub Pages (tools/github-pages/ml-callback.html) que repassa para a API local.
ML_REDIRECT_URI=
HTTPS_PORT=3443
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Parâmetros de afiliado acrescentados aos links capturados (opcional; também pode ser salvo pela tela Configurações)
SHOPEE_AFFILIATE_SUFFIX=
ML_AFFILIATE_SUFFIX=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_IG_USER_ID=
META_API_VERSION=v23.0
# E-mail para "esqueci a senha" (pode ser preenchido pela tela Configurações em vez daqui)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
